# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase secret / service-role key. Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Public app URL, used for auth redirects and email links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paystack (primary payment provider — see lib/billing/paystack-client.ts).
# Use TEST keys (sk_test_/pk_test_) in development, LIVE keys (sk_live_/pk_live_)
# only in production. Never commit real values. The secret key and webhook
# secret must never be exposed to the browser — only NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY
# is safe client-side, and this app currently doesn't even need it client-side
# since checkout is initialized server-side (see lib/billing/paystack-provider.ts).
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# From Paystack Dashboard -> Settings -> API Keys & Webhooks -> Webhook URL
# signing (Paystack signs webhooks with your secret key by default; set this
# only if you configure a distinct webhook signing secret).
PAYSTACK_WEBHOOK_SECRET=

# One Paystack Plan code per (plan, billing interval) — create these in the
# Paystack Dashboard (Products -> Plans) or via the Paystack API, matching
# the prices in lib/billing/plans.ts exactly, then paste the resulting
# plan_code (e.g. PLN_xxxxxxxx) below. Deliberately not hard-coded anywhere
# in the app (spec v1.1 §12) — lib/billing/paystack-plan-codes.ts is the only
# place that reads these.
PAYSTACK_PLAN_CODE_CREATOR_MONTHLY=
PAYSTACK_PLAN_CODE_CREATOR_QUARTERLY=
PAYSTACK_PLAN_CODE_CREATOR_ANNUAL=
PAYSTACK_PLAN_CODE_PRO_MONTHLY=
PAYSTACK_PLAN_CODE_PRO_QUARTERLY=
PAYSTACK_PLAN_CODE_PRO_ANNUAL=
