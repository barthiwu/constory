# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase secret / service-role key. Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Public app URL, used for auth redirects and email links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paystack (primary payment provider — see lib/billing/paystack-client.ts).
# Use TEST keys (sk_test_/pk_test_) in development, LIVE keys (sk_live_/pk_live_)
# only in production. Never commit real values. The secret key and webhook
# secret must never be exposed to the browser — only NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY
# is safe client-side, and this app currently doesn't even need it client-side
# since checkout is initialized server-side (see lib/billing/paystack-provider.ts).
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# From Paystack Dashboard -> Settings -> API Keys & Webhooks -> Webhook URL
# signing (Paystack signs webhooks with your secret key by default; set this
# only if you configure a distinct webhook signing secret).
PAYSTACK_WEBHOOK_SECRET=

# One Paystack Plan code per (plan, billing interval) — create these in the
# Paystack Dashboard (Products -> Plans) or via the Paystack API, matching
# the prices in lib/billing/plans.ts exactly, then paste the resulting
# plan_code (e.g. PLN_xxxxxxxx) below. Deliberately not hard-coded anywhere
# in the app (spec v1.1 §12) — lib/billing/paystack-plan-codes.ts is the only
# place that reads these.
PAYSTACK_PLAN_CODE_CREATOR_MONTHLY=
PAYSTACK_PLAN_CODE_CREATOR_QUARTERLY=
PAYSTACK_PLAN_CODE_CREATOR_ANNUAL=
PAYSTACK_PLAN_CODE_PRO_MONTHLY=
PAYSTACK_PLAN_CODE_PRO_QUARTERLY=
PAYSTACK_PLAN_CODE_PRO_ANNUAL=

# Prices are always shown in USD (lib/billing/plans.ts) so the app reads the
# same worldwide, but Paystack can only charge in whatever currency is
# enabled on this integration — most Nigeria-registered businesses only have
# NGN enabled by default (USD requires Paystack's international-payments
# approval, a Zenith Bank USD domiciliary account, and only Kenya/Nigeria
# businesses can hold USD at all). See lib/billing/currency.ts.
# CHARGE_CURRENCY must match the currency the Paystack Plan codes above were
# actually created in, or checkout fails with "Currency not supported by
# merchant". USD_TO_NGN_RATE is a manually-maintained approximation used for
# the amount field and audit-trail metadata (Paystack actually charges the
# Plan's own configured amount for plan-code checkouts) — NGN floats, so
# update this periodically rather than leaving it stale.
PAYSTACK_CHARGE_CURRENCY=NGN
USD_TO_NGN_RATE=1500

# Resend (email provider for lib/notifications/email.ts, called directly
# over fetch — no SDK/install required) — low-credit warnings,
# scheduled-post reminders, and the weekly digest. Without this set, those
# emails are skipped with a console warning (the in-app notification bell
# still works either way). Sign up at resend.com, verify a sending domain,
# then set RESEND_FROM_EMAIL to an address on it — otherwise Resend only
# delivers to your own account's address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Constory <notifications@yourdomain.com>

# Shared secret for the two notification cron routes
# (app/api/cron/post-reminders, app/api/cron/weekly-digest — see
# vercel.json). Vercel Cron sends this automatically as
# `Authorization: Bearer <value>` once this env var is set in your Vercel
# project. Generate any long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Stripe (second payment provider, built but NOT activated in V1 — see
# lib/billing/stripe-provider.ts's file header. getBillingProvider() in
# lib/billing/provider.ts never selects Stripe on its own; wiring it up is a
# deliberate V2 step, not something setting these env vars alone triggers).
# Use TEST keys (sk_test_/whsec_ from `stripe listen`) while building this
# out. Requires `npm install stripe` — not installed by default since it's
# unused until activated.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_CREATOR_MONTHLY=
STRIPE_PRICE_ID_CREATOR_QUARTERLY=
STRIPE_PRICE_ID_CREATOR_ANNUAL=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_QUARTERLY=
STRIPE_PRICE_ID_PRO_ANNUAL=
